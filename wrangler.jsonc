// Cloudflare Workers 설정 — 정적 자산만 서빙하는 Worker (스크립트 없음).
// 문서: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gmmaritime",
  "compatibility_date": "2026-10-17",
  "assets": {
    // 저장소 루트를 그대로 올립니다. 올리지 않을 파일은 .assetsignore 에 적습니다.
    "directory": "./",
    // "none": /about.html 같은 기존 URL을 리다이렉트 없이 그대로 서빙합니다.
    // (기본값 auto-trailing-slash 는 /about.html → /about 으로 307 리다이렉트하므로
    //  sitemap.xml · canonical · 내부 링크가 모두 바뀌어야 해서 쓰지 않습니다.)
    "html_handling": "none",
    // 없는 경로는 루트의 404.html 을 404 상태로 돌려줍니다.
    "not_found_handling": "404-page"
  }
  // 2단계(도메인 전환)에서 아래 주석을 풀어 배포하면 Cloudflare 가
  // gmmaritime.com 의 DNS A 레코드를 이 Worker 로 바꿉니다.
  // CI(비대화형)에서는 기존 레코드를 묻지 않고 덮어씁니다.
  // www.gmmaritime.com 은 여기 넣지 않습니다. _redirects 가 호스트 기준 리다이렉트를
  // 지원하지 않으므로, 대시보드에서 www 를 프록시된 플레이스홀더 레코드(A 192.0.2.0)로
  // 두고 Redirect Rule(www → apex, 301)로 처리합니다. 지금 GitHub Pages 동작과 같습니다.
  // "routes": [{ "pattern": "gmmaritime.com", "custom_domain": true }]
}
