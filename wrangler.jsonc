// Cloudflare Workers 설정.
// 정적 파일은 Static Assets 가 서빙하고, src/worker.js 는 /api/* 와 404 경로만 처리합니다.
// 문서: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gmmaritime",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-17",
  "assets": {
    // 저장소 루트를 그대로 올립니다. 올리지 않을 파일은 .assetsignore 에 적습니다.
    "directory": "./",
    // Worker 코드에서 env.ASSETS.fetch() 로 정적 파일을 돌려줄 때 씁니다.
    "binding": "ASSETS",
    // /api/* 와 옛 아티클 주소(/article.html → 301)는 자산을 찾기 전에 Worker 를 먼저 실행합니다.
    // 나머지는 자산 우선이며, 자산이 없으면 Worker 를 거치지 않고 404.html 이 나갑니다.
    "run_worker_first": ["/api/*", "/article.html"],
    // "none": /about.html 같은 기존 URL을 리다이렉트 없이 그대로 서빙합니다.
    // (기본값 auto-trailing-slash 는 /about.html → /about 으로 307 리다이렉트하므로
    //  sitemap.xml · canonical · 내부 링크가 모두 바뀌어야 해서 쓰지 않습니다.)
    "html_handling": "none",
    // 없는 경로는 루트의 404.html 을 404 상태로 돌려줍니다.
    "not_found_handling": "404-page"
  },
  // 공개 설정값. 비밀 키(TURNSTILE_SECRET_KEY, EMAILJS_PRIVATE_KEY)는 여기 쓰지 않고
  // GitHub Secrets → deploy.yml 의 secrets 입력으로 Worker 에 바인딩합니다.
  // 로컬 개발은 .dev.vars (git 제외) 에서 덮어씁니다.
  "vars": {
    "TURNSTILE_HOSTNAMES": "gmmaritime.com",
    "EMAILJS_PUBLIC_KEY": "oxNyGY4Y3JcIsG6Ml",
    "EMAILJS_SERVICE_ID": "service_molk",
    "EMAILJS_TEMPLATE_ID": "template_owc4fne"
  },
  "observability": {
    "enabled": true
  },
  // 커스텀 도메인. 배포 시 Cloudflare 가 gmmaritime.com 의 DNS 레코드를 이 Worker 로 맞춥니다.
  // www.gmmaritime.com 은 여기 넣지 않습니다. _redirects 가 호스트 기준 리다이렉트를
  // 지원하지 않으므로, 대시보드에서 www 레코드를 프록시로 두고
  // Redirect Rule(www → apex, 301)로 처리합니다.
  "routes": [{ "pattern": "gmmaritime.com", "custom_domain": true }]
}
