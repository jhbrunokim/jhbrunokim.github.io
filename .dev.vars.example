# 로컬 개발용 바인딩. 이 파일을 .dev.vars 로 복사해서 쓰십시오 (.dev.vars 는 git 에 올라가지 않습니다).
# wrangler dev 는 .dev.vars 의 값으로 wrangler.jsonc 의 vars 를 덮어씁니다.

# Cloudflare 가 제공하는 Turnstile 테스트 키. 항상 통과하며 hostname 으로 example.com 을 돌려줍니다.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# 로컬에서는 실제 메일을 보내지 않도록 가짜 엔드포인트를 가리킵니다.
# (실제 메일을 보내려면 EMAILJS_API_URL 을 지우고 EMAILJS_PRIVATE_KEY 에 계정 비공개 키를 넣으십시오.)
EMAILJS_PRIVATE_KEY=local-dev-dummy
EMAILJS_API_URL=http://127.0.0.1:8790/send
