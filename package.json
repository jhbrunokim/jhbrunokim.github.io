{
  "name": "gmmaritime-website",
  "version": "1.0.0",
  "description": "Gwangmyung Maritime corporate website",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/styles.css -o ./assets/css/output.css --minify",
    "build:articles": "node scripts/build-articles.mjs",
    "build": "npm run build:css && npm run build:articles",
    "dev": "tailwindcss -i ./assets/css/styles.css -o ./assets/css/output.css --watch",
    "check:csp": "node scripts/csp-hashes.mjs --check",
    "csp:update": "node scripts/csp-hashes.mjs --write"
  },
  "keywords": [
    "maritime",
    "shipping",
    "compliance"
  ],
  "author": "Gwangmyung Maritime",
  "license": "UNLICENSED",
  "devDependencies": {
    "marked": "15.0.12",
    "tailwindcss": "^3.4.1",
    "wrangler": "4.151.1"
  }
}
