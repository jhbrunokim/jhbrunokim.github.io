# Cloudflare Workers 정적 자산 응답 헤더.
# 문서: https://developers.cloudflare.com/workers/static-assets/headers/
#
# Content-Security-Policy 의 'sha256-…' 항목은 루트 *.html 의 인라인 <script> 해시입니다.
# 인라인 스크립트를 고치면 `npm run csp:update` 로 다시 쓰고, CI 는 `npm run check:csp` 로 검사합니다.
# 허용 출처:
#   script-src   cdn.jsdelivr.net (Lucide, marked) · challenges.cloudflare.com (Turnstile)
#                static.cloudflareinsights.com (Cloudflare Web Analytics)
#   style-src    self 만 (웹 글꼴은 assets/fonts/ 에 자체 호스팅). style-src-attr 'unsafe-inline' 은 style="--step: n" 속성용
#   font-src     self (assets/fonts/*.woff2)
#   connect-src  /api/contact (self) · cloudflareinsights.com
#   frame-src    challenges.cloudflare.com (Turnstile 위젯)

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://challenges.cloudflare.com https://static.cloudflareinsights.com 'sha256-M4BCoy0UTaRFbZNcVmMyoz0n0u8USNtB+Wz7TQidpmk=' 'sha256-YOT9/4FeGeU33QkvoYW5NtBmwk3PF61I/4wCgWjG2yk=' 'sha256-bQpoLIPd5b8SMkVti4+pvFCfxXaigJ7dzGpqhJQbKBc=' 'sha256-cJIZzoUmlH/8qZWb0wDuyNPnRSMj8O4Qvoijqs6B3DQ=' 'sha256-dhZRUz0hrIz1kuQgiiX8OSXcg0/+DqIw4m8BOtBID3w='; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# 캐시 정책. 위 /* 블록은 Cache-Control 을 설정하지 않으므로 아래 값이 그대로 적용됩니다.
# 이미지·로고·파비콘은 거의 바뀌지 않아 7일 캐시, 만료 후 하루 동안은 이전 사본을 쓰며 백그라운드로 갱신합니다.
/resource/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# 자체 호스팅 글꼴(woff2 + @font-face CSS)은 scripts/fetch-fonts.mjs 를 다시 돌릴 때만 바뀌므로 이미지와 같이 7일 캐시합니다.
/assets/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# CSS/JS 는 파일명에 해시가 없어 배포 직후 반영되도록 1시간만 캐시합니다.
/assets/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
